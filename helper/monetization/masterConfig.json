      "synthesis",
      "meaning_layer",
      "hidden_patterns",
      "identity_patterns",
      "relationship_dynamics",
      "current_season",
      "growth_edge",
      "timing_analysis",
      "life_direction",
      "destiny_flow",
      "life_purpose",
      "core_nature"
    ],
    "unlistedFeatureIs": "pro"
  },
  "companionTalk": {
    "countedCategories": [
      "Astria Talk",
      "Companion Talk",
      "HealJai Talk"
    ],
    "free": {
      "dailyQuestionLimit": 12,
      "softWarningAt": 10,
      "included": [
        "emotional_reflection",
        "pattern_observation",
        "perspective_shift",
        "light_life_gps",
        "guided_followup"
      ]
    },
    "pro": {
      "unlimitedQuestions": true,
      "included": [
        "identity_analysis",
        "worthiness_layer",
        "life_script",
        "origin_pattern",
        "uranian_layers",
        "let_it_ride"
      ]
    },
    "upsellTriggers": {
      "softMessage": "You're approaching today's companion limit.",
      "hardMessage": "There may be a deeper pattern underneath this conversation. Continue with Astria Pro.",
      "showProOfferWhenUserAsks": [
        "why_am_i_like_this",
        "why_does_this_keep_happening",
        "where_does_this_come_from",
        "repeating_pattern",
        "identity_pattern",
        "life_script",
        "worthiness"
      ]
    }
  },
