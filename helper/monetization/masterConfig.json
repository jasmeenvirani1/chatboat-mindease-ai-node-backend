{
  "version": "1.0.0",
  "status": "candidate",
  "notes": "Single source of truth for Free/Pro. Loaded by helper/monetization/index.js. A bad file never crashes the server: monetization just stays off.",
  "corePrinciple": {
    "free": "See",
    "pro": "Understand",
    "freeGoal": "Build trust through real value",
    "proGoal": "Deliver meaning, patterns and self-discovery"
  },
  "globalRules": {
    "neverBlockTabs": true,
    "neverBlockCategories": true,
    "freePreviewDepthPercent": 40,
    "freeCanAccess": [
      "overview",
      "snapshot",
      "opening_insight",
      "daily_flow",
      "current_energy",
      "charts",
      "scores",
      "basic_observations"
